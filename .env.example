# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional: Webhook URL if you also want to mirror to Google Sheets / Make / Zapier
# WAITLIST_WEBHOOK_URL=https://hooks.zapier.com/...
